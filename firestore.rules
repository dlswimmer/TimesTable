rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // One document per family, named by its 12-character family code.
    // Knowing the code is what grants access, so codes are long and random.
    match /families/{code} {
      allow read: if code.size() == 12;
      allow create, update: if code.size() == 12
        && request.resource.data.data.size() < 500000;
    }
    // Read-only teacher reports: a snapshot of math progress, named by a
    // separate 16-character code. Deleting it turns the teacher link off.
    match /reports/{code} {
      allow read, delete: if code.size() == 16;
      allow create, update: if code.size() == 16
        && request.resource.data.data.size() < 300000;
    }
  }
}
